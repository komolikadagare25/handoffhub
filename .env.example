# Copy to .env (never commit .env)
PORT=3000
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=20000
LOG_LEVEL=info
# Where the SQLite file and logs live (point these at a persistent disk in production)
DB_PATH=./data/handoffhub.db
LOG_DIR=./logs
# Load sample data on first start (set false to start empty)
SEED=true
